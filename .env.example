# ─────────────────────────────────────────────────────────────
# Substrate — Environment Variables Template
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.
# ─────────────────────────────────────────────────────────────

# Jules — AI coding agent API key
# Get from: https://jules.google.com/settings
JULES_API_KEY=

# Stitch — AI design agent API key (usually same as Jules key)
STITCH_API_KEY=

# GitHub App — created at https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# PostgreSQL — local or hosted database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/substrate

# Cloudflare — for Workers/R2 (Phase 3+)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
