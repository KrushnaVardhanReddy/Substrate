		"@testing-library/svelte": "^5.4.2",
		"@types/d3": "^7.4.3",
		"@types/dagre": "^0.7.54",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26.1.1",
		"jsdom": "^29.1.1",
		"svelte": "^5.56.1",
