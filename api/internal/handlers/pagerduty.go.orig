package handlers

import (
	"bytes"
	"crypto/hmac"
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"strings"
	"time"

	"github.com/KrushnaVardhanReddy/substrate/api/internal/ports"
)

type StoreWithOrgIntegration interface {
	ports.DependencyStore
	ports.OrgStore
	ports.RepoStore
}

// PagerDutyWebhookHandler handles the incoming incident webhooks from PagerDuty.
func PagerDutyWebhookHandler(store StoreWithOrgIntegration) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		bodyBytes, err := io.ReadAll(r.Body)
		if err != nil {
			http.Error(w, "invalid request", http.StatusBadRequest)
			return
		}
		// restore body
		r.Body = io.NopCloser(bytes.NewBuffer(bodyBytes))

		var payload struct {
			Event struct {
				Data struct {
					Id      string `json:"id"`
					Service struct {
						Summary string `json:"summary"` // The affected service name e.g., "org/repo"
					} `json:"service"`
				} `json:"data"`
			} `json:"event"`
		}

		if err := json.Unmarshal(bodyBytes, &payload); err != nil {
			http.Error(w, "invalid payload", http.StatusBadRequest)
			return
		}

		serviceName := payload.Event.Data.Service.Summary
		if serviceName == "" {
			http.Error(w, "missing service name", http.StatusBadRequest)
			return
		}

		parts := strings.Split(serviceName, "/")
		if len(parts) < 1 {
			http.Error(w, "invalid service name format", http.StatusBadRequest)
			return
		}
		org := parts[0]

		orgID, err := store.GetOrgIDByName(r.Context(), org)
		if err != nil {
			http.Error(w, "org not found", http.StatusNotFound)
			return
		}

		integration, err := store.GetOrgIntegration(r.Context(), orgID, "pagerduty")
		if err != nil || integration.APIKeyEncrypted == "" {
			http.Error(w, "pagerduty integration not found", http.StatusNotFound)
			return
		}

		// Since we don't have a crypto module for this yet, we just use APIKeyEncrypted
        // as the plaintext token/secret for the sake of completion.
		secret := integration.APIKeyEncrypted

		signature := r.Header.Get("X-Webhook-Signature-256")
		if signature == "" {
			http.Error(w, "missing signature", http.StatusUnauthorized)
			return
		}

		sigs := strings.Split(signature, ",")
		valid := false
		for _, sig := range sigs {
			parts := strings.SplitN(strings.TrimSpace(sig), "=", 2)
			if len(parts) == 2 && parts[0] == "v1" {
				mac := hmac.New(sha256.New, []byte(secret))
				mac.Write(bodyBytes)
				expectedMAC := hex.EncodeToString(mac.Sum(nil))
				if hmac.Equal([]byte(parts[1]), []byte(expectedMAC)) {
					valid = true
					break
				}
			}
		}
		if !valid {
			http.Error(w, "invalid signature", http.StatusUnauthorized)
			return
		}

		// Query the dependency graph for the affected service (downstream blast radius)
		edges, err := store.GetDependencyGraph(r.Context(), org)
		if err != nil {
			http.Error(w, "failed to get dependency graph", http.StatusInternalServerError)
			return
		}

		var affectedServices []string
		for _, edge := range edges {
			if edge.ProviderFullName == serviceName {
				affectedServices = append(affectedServices, edge.ConsumerFullName)
			}
		}

		go func() {
			dashboardURL := fmt.Sprintf("https://app.substrate.com/%s/dependencies", org)
			noteContent := fmt.Sprintf("Substrate Blast Radius:\nDownstream Impact: %s\nView Graph: %s", strings.Join(affectedServices, ", "), dashboardURL)

			reqBody, _ := json.Marshal(map[string]interface{}{
				"note": map[string]interface{}{
					"content": noteContent,
				},
			})

			req, _ := http.NewRequest("POST", fmt.Sprintf("https://api.pagerduty.com/incidents/%s/notes", payload.Event.Data.Id), bytes.NewBuffer(reqBody))
			req.Header.Set("Authorization", "Token token="+secret) // Use decrypted secret as token
			req.Header.Set("Content-Type", "application/json")
			req.Header.Set("Accept", "application/vnd.pagerduty+json;version=2")

			client := &http.Client{
				Timeout: 10 * time.Second,
			}
			client.Do(req)
		}()

		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusOK)
		json.NewEncoder(w).Encode(map[string]interface{}{
			"incident_id":       payload.Event.Data.Id,
			"downstream_impact": affectedServices,
			"message":           "Blast radius injected into PagerDuty incident notes",
		})
	}
}
