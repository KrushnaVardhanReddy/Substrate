{
  "$schema": "node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.3.0",
    "generators": {
      "inventory-client": {
        "generatorName": "typescript-axios",
        "output": "#{cwd}/src/clients/inventory",
        "glob": "api/inventory.yaml",
        "inputSpec": "https://raw.githubusercontent.com/myorg/inventory-api/main/openapi.yaml"
      }
    }
  }
}
